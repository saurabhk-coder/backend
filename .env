POSTGRES_SERVER=35.232.68.79
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin
POSTGRES_DB=aaralia-dev

# PostgreSQL schema
DB_SCHEMA=hrms
DB_ANON_ROLE=postgres


# ============================================================
# JWT
# ============================================================

SECRET_KEY=YOUR_NEW_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ============================================================
# Azure Blob Storage
# Keep these only if your application still uses Azure Blob
# ============================================================

AZURE_BLOB_CONNECTION_STRING=YOUR_AZURE_CONNECTION_STRING
AZURE_BLOB_SAS_TOKEN=YOUR_AZURE_SAS_TOKEN
AZURE_BASE_URL=https://tooliqadevstorage.blob.core.windows.net/